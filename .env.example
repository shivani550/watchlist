# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Either provide full DATABASE_URL or individual PG* variables
DATABASE_URL=postgres://postgres:postgres@localhost:5432/watchlist_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=watchlist_db

# Security
JWT_SECRET=dev_jwt_secret_key_change_in_production_min32chars!

# External API Keys & Providers
MARKET_DATA_API_KEY=
NEWS_API_KEY=
MARKETAUX_API_TOKEN=
NEWS_REACTION_WINDOW_MINUTES=120

